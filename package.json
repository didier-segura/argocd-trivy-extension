{
  "name": "argocd-trivy-extension",
  "version": "0.4.4",
  "private": true,
  "dependencies": {
    "@emotion/react": "^11.11.4",
    "@emotion/styled": "^11.11.5",
    "@mui/material": "^5.15.14",
    "axios": "1.6.8",
    "gridjs": "^6.2.0",
    "gridjs-react": "^6.1.1",
    "recharts": "^2.12.3"
  },
  "peerDependencies": {
    "moment": "^2.29.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "browser": {
    "fs": false,
    "path": false,
    "os": false
  },
  "scripts": {
    "start": "vite",
    "build": "vite build && rm -f ./dist/resources/extension-trivy.tar && tar -C dist -cvf ./dist/extension-trivy.tar resources && mv ./dist/extension-trivy.tar ./dist/resources/"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "@vitejs/plugin-react": "^4.2.1",
    "sass": "^1.72.0",
    "vite": "^5.2.8",
    "vite-plugin-css-injected-by-js": "^3.5.2"
  }
}
